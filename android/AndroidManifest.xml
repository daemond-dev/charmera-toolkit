<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.daemonddev.charmera">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Internet only to download the public stock dump from GitHub. The card is reached through Android's folder
         picker, which grants access to the one folder the user chooses, so no storage permission is needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To install an in-app update (the "Check for updates" button). The app only ever installs its own newer build,
         downloaded from its GitHub releases, and the user confirms every install in Android's own installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" and "Share" for a downloaded update file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Full-screen reference target to photograph on each firmware iteration (CalibrationActivity). Landscape to
             match the camera's landscape frame; no action bar so the card fills the screen; brightness is tunable. -->
        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <!-- Serves the downloaded update APK to the system installer as a content:// URI; see ApkProvider. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="io.github.daemonddev.charmera.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
